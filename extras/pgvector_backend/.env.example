# =============================================================================
# LMC-5 pgvector backend · 环境变量模板
# =============================================================================
# 复制为 .env，按部署实际填值。**不要 commit 真值到任何 repo。**
# 加载方式见调用方（推荐 python-dotenv / systemd EnvironmentFile / docker secrets）。
# =============================================================================


# -----------------------------------------------------------------------------
# 数据库
# -----------------------------------------------------------------------------
# PostgreSQL DSN。VPS 上推荐走 unix socket 或 localhost；走公网需 SSL。
LMC5_PG_DSN=postgresql://lmc5:CHANGE_ME@localhost:5432/lmc5

# 可选：连接池大小。多 worker 并发时调大。
LMC5_PG_POOL_SIZE=5


# -----------------------------------------------------------------------------
# Embedding 服务（选一个）
# -----------------------------------------------------------------------------
# 选项 A · Gemini embedding 2（推荐多语种，3072d）
GEMINI_API_KEY=
LMC5_EMBED_MODEL=gemini-embedding-2
LMC5_EMBED_DIM=3072

# 选项 B · Voyage AI（推荐英文/代码场景，1024d）
# VOYAGE_API_KEY=
# LMC5_EMBED_MODEL=voyage-3-large
# LMC5_EMBED_DIM=1024

# 选项 C · 本地 BGE-M3（offline，需先把模型下到本地）
# LMC5_EMBED_MODEL=bge-m3
# LMC5_EMBED_DIM=1024
# LMC5_EMBED_LOCAL_PATH=/opt/models/bge-m3


# -----------------------------------------------------------------------------
# Housekeeper LLM（dream / Z 判定 / E 评分等共用）
# -----------------------------------------------------------------------------
# DeepSeek（默认推荐：便宜 + JSON mode 稳）
DEEPSEEK_API_KEY=
LMC5_HOUSEKEEPER_MODEL_CHEAP=deepseek-chat       # 用于 hippocampus 提议、关系命名
LMC5_HOUSEKEEPER_MODEL_HEAVY=deepseek-v4-pro     # 用于 Z 判定 / E 评分

# 备用：OpenAI / Anthropic / 任意其他
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# 调参（覆盖 LMC5Config 默认值；不填走 config.py 里的默认）
# -----------------------------------------------------------------------------
# 去重相似度阈值（默认 0.92；放宽→0.88，严格→0.95）
# LMC5_DEDUP_SIMILARITY=0.92

# 做梦 batch size（默认 8；上下文小或慢就降到 4）
# LMC5_DREAM_BATCH_SIZE=8

# 闸门 importance 阈值（默认 7；候选少就降到 5）
# LMC5_DREAM_IMPORTANCE_THRESHOLD=7

# LLM 调用重试上限（默认 3）
# LMC5_LLM_MAX_RETRIES=3

# 单次 LLM 调用超时秒（默认 60）
# LMC5_LLM_TIMEOUT_S=60

# E 轴影子期天数（默认 30，不到期不参与排序）
# LMC5_E_AXIS_SHADOW_DAYS=30

# 同一 Claude session 跨轮注入去重（UserPromptSubmit hook 默认开启）。
# 状态只存 namespace+source_id 的哈希；换 session 自动隔离，旧文件默认 2 天清理。
# LMC5_SESSION_RECALL_DEDUP=1
# LMC5_SESSION_RECALL_STATE_DIR=/tmp/lmc5_session_recall
# LMC5_SESSION_RECALL_TTL_SECONDS=172800
# LMC5_SESSION_RECALL_MAX_KEYS=1024


# -----------------------------------------------------------------------------
# 前端 / Frontend（按你选的前端填一个，可全留空）
# -----------------------------------------------------------------------------
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=             # 逗号分隔，限制可访问的 chat_id

# 自托管 Web UI
LMC5_WEB_HOST=127.0.0.1
LMC5_WEB_PORT=5200
LMC5_WEB_SECRET=                       # session 签名密钥；用 `openssl rand -hex 32` 生成


# -----------------------------------------------------------------------------
# 运维 / Operations
# -----------------------------------------------------------------------------
# 日志路径
LMC5_LOG_DIR=/var/log/lmc5

# 备份目录（systemd timer 推荐每天 dump 一份）
LMC5_BACKUP_DIR=/var/backups/lmc5

# 时区（影响 nightly cron 执行时间）
TZ=Asia/Shanghai
