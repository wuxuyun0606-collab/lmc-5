# PostgreSQL reference backend. Export settings into the hook or worker process.
# Local example using the current PostgreSQL role. Create this database first.
LMC5_PG_DSN='dbname=lmc5_demo'

# Optional HTTP adapters require requests. The hook checks for an embedder in
# Gemini, Voyage, OpenAI order, then tries local sentence-transformers if installed.
# Reranking checks Voyage, DeepSeek, then OpenAI. Supply only the keys you intend
# the hook to use. Keyword recall with a fresh driver-only environment needs none.
# GEMINI_API_KEY=
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# These settings are read by applications that call LMC5Config.from_env().
# The default prompt hook constructs its vector store with the 3072d Gemini
# defaults. To change models, wire the embedder and store together and use a
# matching SQL column dimension. See README.md.
# LMC5_EMBED_MODEL_NAME=gemini-embedding-2
# LMC5_EMBED_DIM=3072
# LMC5_DEDUP_SIMILARITY=0.92
# LMC5_DREAM_BATCH_SIZE=8
# LMC5_DREAM_IMPORTANCE_THRESHOLD=7

# Optional prompt-hook settings. The default output is flat.
# LMC5_RECALL_OUTPUT=layered
# LMC5_RECALL_CONTENT_DEDUP=1
# LMC5_SESSION_RECALL_DEDUP=1
# LMC5_SESSION_RECALL_STATE_DIR=/var/lib/lmc5/session-recall
# LMC5_PERCEPTION_CACHE=/var/lib/lmc5/perception.json
# LMC5_COLD_ARCHIVE_FALLBACK=0
